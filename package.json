{
  "name": "slotbook",
  "private": true,
  "description": "SlotBook: booking for meeting rooms and shared equipment.",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
