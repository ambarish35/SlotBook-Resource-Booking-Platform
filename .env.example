# SlotBook API settings. Copy this file to .env (same folder) and fill in real values.
# .env is ignored by git. Never commit real credentials.

# MongoDB connection string, including the database user's credentials.
# It must point to a replica set (e.g. MongoDB Atlas), because bookings use transactions.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Secret that signs session tokens. Required. Use a long random value (at least 32 characters) and never commit it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-random-secret-at-least-32-chars>

# Demo accounts created by `npm run seed` (safe to run again). Only the seed command reads these.
# Passwords need 8 to 72 characters. Re-running never changes an existing account's password.
SEED_ADMIN_EMAIL=<admin-email>
SEED_ADMIN_PASSWORD=<choose-a-password>
SEED_MEMBER_EMAIL=<member-email>
SEED_MEMBER_PASSWORD=<choose-a-password>
# Optional display names (defaults: Admin, Member).
# SEED_ADMIN_NAME=Admin
# SEED_MEMBER_NAME=Member

# Optional: database name (default: slotbook). Overrides any database named in MONGODB_URI.
# MONGODB_DB_NAME=slotbook

# Optional: API port (default: 4000). The client dev server forwards /api to port 4000.
# PORT=4000
