# SlotBook API settings. Copy this file to .env (same folder) and fill in real values.
# .env is ignored by git. Never commit real credentials.

# MongoDB connection string, including the database user's credentials.
# It must point to a replica set (e.g. MongoDB Atlas), because bookings use transactions.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Optional: database name (default: slotbook). Overrides any database named in MONGODB_URI.
# MONGODB_DB_NAME=slotbook

# Optional: API port (default: 4000). The client dev server forwards /api to port 4000.
# PORT=4000
